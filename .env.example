# ---- World Monitor Security Assessment Platform configuration ----
# Copy to .env and adjust. NEVER commit .env.

APP_NAME="World Monitor Security Assessment Platform"
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-64-random-hex-chars
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Storage
DATABASE_URL=sqlite:///database/worldmonitor.db
EVIDENCE_DIR=evidence
REPORT_DIR=reports

# Authorization gate — LAB_MODE only permits localhost/private-lab targets
LAB_MODE=true
ALLOWED_TARGETS=

# Local vulnerable lab
LAB_APP_URL=http://127.0.0.1:8080
LAB_SOURCE_DIR=lab/vulnerable-world-monitor

# Bootstrap platform accounts (change before any real deployment!)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe_Admin_2026!
ANALYST_EMAIL=analyst@example.com
ANALYST_PASSWORD=ChangeMe_Analyst_2026!

MAX_SCAN_WORKERS=4
API_RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=30
