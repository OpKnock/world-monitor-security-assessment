# ---- World Monitor Security Assessment Platform configuration ----
# Copy to .env and adjust. NEVER commit .env.

APP_NAME="World Monitor Security Assessment Platform"
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT: Use a strong random secret in production!
SECRET_KEY=CHANGE-ME-64-random-hex-chars
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Storage
DATABASE_URL=sqlite:///database/worldmonitor.db
EVIDENCE_DIR=evidence
REPORT_DIR=reports

# Authorization gate — LAB_MODE only permits localhost/private-lab targets
LAB_MODE=true
ALLOWED_TARGETS=

# Local vulnerable lab
LAB_APP_URL=http://127.0.0.1:8080
LAB_SOURCE_DIR=lab/vulnerable-world-monitor

# Bootstrap platform accounts (MUST change before any real deployment!)
# Generate strong passwords: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe_Use_Strong_Password_Here
ANALYST_EMAIL=analyst@example.com
ANALYST_PASSWORD=ChangeMe_Use_Strong_Password_Here

MAX_SCAN_WORKERS=4
API_RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=30

# JWT Configuration
JWT_AUDIENCE=world-monitor-api
