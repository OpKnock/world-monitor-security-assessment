# ---- World Monitor Security Assessment Platform configuration ----
# Copy to .env and adjust. NEVER commit .env.
# Every variable below maps 1:1 to backend/app/config.py (case-insensitive).

APP_NAME="World Monitor Security Assessment Platform"
VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# --- Secrets (MUST change before any real deployment!) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT: leaving the placeholder SECRET_KEY only works with DEBUG or LAB_MODE on.
SECRET_KEY=CHANGE-ME-64-random-hex-chars
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256
JWT_ISSUER=world-monitor
JWT_AUDIENCE=world-monitor-api

# --- Storage ---
DATABASE_URL=sqlite:///database/worldmonitor.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
EVIDENCE_DIR=evidence
REPORT_DIR=reports

# --- Authorization gate — LAB_MODE only permits loopback/private-lab targets ---
LAB_MODE=true
ALLOWED_TARGETS=
BLOCK_CLOUD_METADATA=true

# --- Local vulnerable lab ---
LAB_APP_URL=http://127.0.0.1:8080
LAB_SOURCE_DIR=lab/vulnerable-world-monitor
LAB_HOST=127.0.0.1
LAB_PORT=8080

# --- External scanner binaries (empty = auto-detect under bin/) ---
BIN_DIR=bin
SECRETS_SCANNER_BIN=
SBOM_SCANNER_BIN=
SUPPLY_CHAIN_SCANNER_BIN=

# --- Bootstrap platform accounts (MUST change before any real deployment!) ---
# Generate strong passwords: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe_Use_Strong_Password_Here
ANALYST_EMAIL=analyst@example.com
ANALYST_PASSWORD=ChangeMe_Use_Strong_Password_Here
# Open self-registration (new accounts get the analyst role).
# Set to false on shared hosts so only seeded accounts can sign in.
REGISTRATION_ENABLED=true

# --- Optional alerting ---
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT=8.0
ALERT_WEBHOOK_SECRET=

# --- Limits ---
MAX_SCAN_WORKERS=4
API_RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=30
ASSESSMENT_RATE_LIMIT_PER_MINUTE=20
SCAN_TIMEOUT_SECONDS=600
EVIDENCE_MAX_SIZE_MB=10

# --- Security headers + CORS ---
# Comma-separated extra origins, or "*" for any origin WITHOUT credentials.
CORS_ALLOW_ORIGINS=
ENABLE_HSTS=true
ENABLE_CSP=true
CSP_POLICY=default-src 'self'; script-src 'self'; object-src 'none'; frame-ancestors 'none'
ENABLE_SECURE_COOKIES=true
